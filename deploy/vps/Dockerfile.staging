FROM golang:1.26.10-alpine AS builder
ENV GOMAXPROCS=2 GOFLAGS=-p=1
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,id=oj-staging-gomod,target=/go/pkg/mod go mod download
COPY . .
RUN grep -q ONJOURNEY_SKIP_AUTO_MIGRATE platform/database/database.go
RUN --mount=type=cache,id=oj-staging-gomod,target=/go/pkg/mod --mount=type=cache,id=oj-staging-gobuild,target=/root/.cache/go-build CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /out/golink app.go
FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /out/golink /app/golink
COPY static ./static
COPY views ./views
COPY docs/swagger.yaml ./docs/swagger.yaml
USER nobody:nobody
EXPOSE 3000
ENTRYPOINT ["/app/golink"]

LABEL id.onjourney.schema-policy="external"
